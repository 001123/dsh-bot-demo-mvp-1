---
// T3 — hero + the three content blocks (AC2, AC3, AC8). All copy comes from
// src/content/site.ts, which mirrors docs/content.md verbatim; nothing is written here.
// The countdown island lands in T7.
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import ContentBlock from '../components/ContentBlock.astro'
import { site } from '../content/site'
---

<BaseLayout>
  <Hero />
  {
    site.blocks.map((block) => (
      <ContentBlock
        heading={block.heading}
        paragraphs={block.paragraphs}
        listItems={'listItems' in block ? block.listItems : undefined}
      />
    ))
  }
</BaseLayout>
